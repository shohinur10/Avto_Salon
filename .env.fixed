# Fixed Environment Configuration for Car Salon
# Using relative paths so nginx can proxy them properly

# API URLs - Use relative paths for nginx proxy
REACT_APP_API_URL=http://72.60.108.222:3001/api
REACT_APP_API_GRAPHQL_URL=http://72.60.108.222:3001/graphql
REACT_APP_API_WS=ws://72.60.108.222:3001/ws

# Next.js Configuration
NODE_ENV=production
