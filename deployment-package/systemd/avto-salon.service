[Unit]
Description=Car Salon 24/7 Application Service
Documentation=https://github.com/your-repo/avto-salon
After=network.target network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/avto-salon
ExecStart=/var/www/avto-salon/start-24-7-server.sh
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=avto-salon

# Environment variables
Environment=NODE_ENV=production
Environment=REACT_APP_API_URL=http://72.60.108.222:4001
Environment=REACT_APP_API_GRAPHQL_URL=http://72.60.108.222:4001/graphql
Environment=REACT_APP_API_WS=ws://72.60.108.222:4001

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/avto-salon
ReadWritePaths=/var/log/avto-salon
ReadWritePaths=/var/backups/avto-salon

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Health check
ExecStartPost=/bin/sleep 30
ExecStartPost=/bin/bash -c 'curl -f http://localhost:3000 || exit 1'

[Install]
WantedBy=multi-user.target
