[Unit]
Description=Car Salon Backup Service
Documentation=https://github.com/your-repo/avto-salon

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/avto-salon
ExecStart=/var/www/avto-salon/backup-and-cleanup.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=avto-salon-backup

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/avto-salon
ReadWritePaths=/var/backups/avto-salon
ReadWritePaths=/var/log/avto-salon

# Resource limits
LimitNOFILE=1024
LimitNPROC=256
